    {"name":"10 Login new password success","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\n  \"email\": \"admin@poolhub.com\",\n  \"password\": \"Admin@1234\"\n}"}}},
