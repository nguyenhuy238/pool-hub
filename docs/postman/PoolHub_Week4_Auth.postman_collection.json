    {"name":"5 Admin create user staff","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\n  \"fullName\": \"Staff New\",\n  \"email\": \"staff.new@poolhub.com\",\n  \"password\": \"Staff@123\",\n  \"role\": \"Staff\"\n}"}}},
