    {"name":"2 Login wrong password","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\n  \"email\": \"admin@poolhub.com\",\n  \"password\": \"Wrong@123\"\n}"}}},
